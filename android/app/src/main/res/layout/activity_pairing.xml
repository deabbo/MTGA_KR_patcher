<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/devOptionsStatusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:paddingBottom="12dp"
        android:text="" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="16dp"
        android:text="아래 버튼을 누르면:\n1) 알림 권한이 아직 없으면 먼저 요청합니다 (코드를 알림으로 입력받기 위해 꼭 필요합니다)\n2) '검색 중...' 알림이 뜨고, 동시에 무선 디버깅 설정 화면으로 이동합니다\n3) 거기서 '페어링 코드로 기기 페어링'을 눌러 6자리 코드를 확인하세요\n4) 코드를 찾으면 같은 알림이 자동으로 '코드 입력' 칸으로 바뀝니다 — 알림을 내려서 그 코드를 입력하면 끝입니다" />

    <Button
        android:id="@+id/notifyInputButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="페어링 시작" />

    <TextView
        android:id="@+id/pairingStatusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="13sp"
        android:fontFamily="monospace"
        android:text="" />

    <Button
        android:id="@+id/toggleManualButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="자동 탐지가 안 될 때: 수동으로 IP 입력하기" />

    <LinearLayout
        android:id="@+id/manualSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="1단계: 페어링 코드로 기기 페어링 화면에 표시된 IP:포트와 코드를 입력하세요."
            android:paddingBottom="8dp" />

        <EditText
            android:id="@+id/pairHostPortInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="페어링 IP:포트 (예: 192.168.0.5:41235)"
            android:inputType="text" />

        <EditText
            android:id="@+id/manualPairCodeInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="페어링 코드 (6자리 숫자)"
            android:inputType="number"
            android:maxLength="6" />

        <Button
            android:id="@+id/pairButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="수동 페어링" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="2단계: 페어링 성공 후, 무선 디버깅 메인 화면에 표시되는 IP:포트(페어링 포트와 다름)를 입력하세요."
            android:paddingBottom="8dp" />

        <EditText
            android:id="@+id/connectHostPortInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="연결 IP:포트 (예: 192.168.0.5:37651)"
            android:inputType="text" />

        <Button
            android:id="@+id/connectButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="수동 연결" />
    </LinearLayout>

</LinearLayout>
</ScrollView>
